<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>
<section id="main_section" class="container padding-container">
  <div id="settings" class="mb-3">
    <h2>Nustatymai:</h2>
    <input type="checkbox" id="arrow_color" name="arrow_color" form="editor_form" style="display: inline-block;">
    <label for="arrow_color">Tamsios rodyklės</label><br>
    <input type="checkbox" id="ip_color" name="ip_color" form="editor_form" style="display: inline-block;">
    <label for="ip_color">Tamsūs dėmesio taškai</label><br>
    <%if (errors && errors.includes("scale")) { %>
    <span style="color:red">Netinkamas dydis</span>
    <% } %>
    <%if (errors && errors.includes("tweakpanes")) { %>
    <span style="color:red">Per daug modulių</span>
    <% } %>
  </div>
  <div id="editor_window" class="mb-3">
    <div id="settings_row" class="row" data-masonry='{"percentPosition": true }'></div>
  </div>
  </div>
  <form id="editor_form" method="POST">
    <div class="dropdown mb-3">
      <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
        Pridėti elementą
      </button>
      <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
        <li id="spotlight"><a class="dropdown-item">Prožektorius</a></li>
        <li id="ambient"><a class="dropdown-item">Supanti šviesa</a></li>
        <li id="interest_point"><a class="dropdown-item">Dėmesio taškas</a></li>
      </ul>
    </div>

    <div class="mb-3">
      <label for="models">Pasirinkite modelį:</label>
      <select name="models" class="form-control" id="models">
        <option value="" selected disabled hidden>Pasirinkite modelį</option>
        <% for(let model of models) { %>
        <option value="<%= model["GLB_ID"]%>"> <%=model["NAME"]%></option>
        <% } %>
      </select>
      <%if (errors && errors.includes("model")) { %>
      <span style="color:red">Nepasirinktas modelis</span>
      <% } %>
    </div>

    <div class="mb-3">
      <label for="background">Pasirinkite foną:</label>
      <select name="background" class="form-control" id="background">
        <option value="" selected disabled hidden>Pasirinkite foną</option>
        <% for(let cubemap of cubemaps) { %>
        <option value="<%=cubemap["id"]%>"> <%=cubemap["cubemap_folder"]%></option>
        <% } %>
      </select>
      <%if (errors && errors.includes("background")) { %>
      <span style="color:red">Fonas yra netinkamas</span>
      <% } %>
    </div>

    <div class="mb-3">
      <label for="name">Produkto pavadinimas:</label>
      <input type="text" class="form-control" id="name" name="name">
      <%if (errors && errors.includes("name")) { %>
      <span style="color:red">Pavadinimo laukelis yra netinkamas</span>
      <% } %>
    </div>

    <div class="mb-3">
      <label for="description">Aprašymas:</label>
      <textarea id="description" class="form-control" name="description" style="resize: none;"></textarea>
      <%if (errors && errors.includes("description")) { %>
      <span style="color:red">Aprašymo laukelis yra netinkamas</span>
      <% } %>
    </div>

    <div class="mb-3">
      <label for="price">Produkto Kaina:</label>
      <div class="input-group mb-3">
        <button type="button" id="price_button" class="btn btn-dark">Pridėti</button>
        <input type="number" class="form-control" id="price" name="price">
      </div>
      <%if (errors && errors.includes("price")) { %>
      <span style="color:red">Kaina yra netinkama</span>
      <% } %>

    </div>
    <input type="hidden" id="scale_form" name="scale_form">
    <div>

      <input type="submit" value="Pateikti" class="form-control btn btn-dark">
    </div>
  </form>
</section>
<script type="module" src="/3D_scripts/Editor.js"></script>
<script src="/masonry/masonry.pkgd.min.js"></script>
<script type="module">
  import {
    BasicEditor
  } from '/3D_scripts/Editor.js';
  import {
    Pane
  } from '/tweakpane/tweakpane.js';

  //readonly attribute for price
  let price = document.getElementById("price");
  price.readOnly = true;
  price.style.backgroundColor = "lightgrey";
  let price_button = document.getElementById("price_button");
  price_button.addEventListener("click", function(target) {
    let parent_input = target.srcElement.parentNode.querySelector("input");
    if (parent_input.readOnly) {
      parent_input.readOnly = false;
      parent_input.style.backgroundColor = "";
    } else {
      parent_input.readOnly = true;
      parent_input.style.backgroundColor = "lightgrey";
    }
  });
  //makes sure the price is not negative 
  price.addEventListener("input", function() {
    if (price.value < 0) {
      price.value = 0;
    }
  });

  let ip_color_state = false;
  //code to change the background
  let background = document.getElementById("background");
  background.addEventListener("change", (listing) => {
    editor.change_background(listing.target.options[listing.target.selectedIndex].text);
  })

  //code to change the color of the arrows
  let arrow_checkbox = document.getElementById("arrow_color");
  arrow_checkbox.addEventListener('change', function() {
    if (this.checked) {
      editor.change_arrow_color("black");
    } else {
      editor.change_arrow_color("white");
    }
  })

  //code to change the color of the interest points
  let ip_color = document.getElementById("ip_color");
  ip_color.addEventListener("change", function() {
    if (this.checked) {
      ip_color_state = true;
      editor.change_interestpoint_color("black");
    } else {
      ip_color_state = false;
      editor.change_interestpoint_color("white");
    }
  });

  //editor
  let editor = new BasicEditor(500, 'main_section', {
    x: 0,
    y: 0,
    z: 30
  }, 10, 30);
  editor.resize();
  editor.animate();
  editor.change_background("black");

  const MAX_TWEAKPANES = 15;
  let TWEAKPANE_AMOUNT = 0;

  //Default size params
  const OBJECT_SCALE_MAX = 20;
  const OBJECT_SCALE_MIN = 1;
  const DEFAULT_SCALE = 5;

  //add a size tweaking pane;
  let scale_form = document.getElementById("scale_form");
  scale_form.value = DEFAULT_SCALE;
  const select = document.getElementById('models');
  const PARAMS = {
    Dydis: DEFAULT_SCALE
  };
  let size_pane = new Pane({
    container: document.getElementById('settings')
  });
  size_pane.addBinding(PARAMS, 'Dydis', {
    min: OBJECT_SCALE_MIN,
    max: OBJECT_SCALE_MAX,
  }).on('change', (ev) => {
    editor.change_size(ev["value"]);
    scale_form.value = `${ev["value"]}`;
  });
  size_pane.hidden = true;

  //event listener to add model on change
  select.addEventListener("change", async (listing) => {
    editor.remove_GLB()
    editor.add_GLB("/GLB_FILES/", listing.target.value, DEFAULT_SCALE, () => {
      size_pane.hidden = false;
      PARAMS.Dydis = DEFAULT_SCALE;
      size_pane.refresh();
    });
  })

  //masonry code
  let masonry;
  window.addEventListener('load', () => {
    const grid = document.querySelector('#settings_row');
    masonry = new Masonry(grid, {
      itemSelector: '.col-12',
      percentPosition: true,
    });
  });

  //Ambient light functionality
  let ambient_button = document.getElementById("ambient");
  let ambient_count = [];
  let removed_ambient = [];
  for (let x = 1; x <= MAX_TWEAKPANES; x++) {
    ambient_count.push(x);
  }
  ambient_button.addEventListener("click", () => {
    if (TWEAKPANE_AMOUNT < MAX_TWEAKPANES) {
      let temp;
      TWEAKPANE_AMOUNT++;
      if (removed_ambient.length > 0) {
        temp = Math.min(...removed_ambient);
        const index = removed_ambient.findIndex(data => data === temp);
        if (index !== -1) {
          removed_ambient.splice(index, 1);
        }
      } else {
        temp = ambient_count[0];
        ambient_count.shift();
      }

      let id = crypto.randomUUID();
      let settings = document.getElementById("settings_row");
      let column = document.createElement("div");
      column.classList = "col-12 col-lg-4 col-md-6 col-sm-6 mb-3";

      const INTENSITY = 1;
      let stiprumas = INTENSITY;
      let spalva;

      //create and append a html input element
      let input_element = document.createElement("INPUT");
      input_element.setAttribute("type", "hidden");
      input_element.id = id;
      input_element.name = "ambient";
      let form = document.getElementById("editor_form");
      form.insertBefore(input_element, form.lastElementChild);
      const pane = new Pane({
        container: column
      });
      const PARAMS = {
        Spalva: {
          r: 1,
          g: 1,
          b: 1
        },
      };
      spalva = PARAMS["Spalva"];
      input_element.value = `{"intensity": ${stiprumas}, "r": ${spalva.r}, "g": ${spalva.g}, "b": ${spalva.b}}`;
      const folder = pane.addFolder({
        title: `Supanti_šviesa_${temp}`,
        expanded: true,
      });
      folder.on('fold', () => {
        setTimeout(() => {
          masonry.layout();
        }, 200);
      });
      folder.addBlade({
        view: 'slider',
        label: 'Stiprumas',
        min: 0,
        max: 20,
        value: INTENSITY,
      }).on('change', (ev) => {
        editor.change_ambient_light_intensity(ev.value, id);
        stiprumas = ev.value;
        input_element.value = `{"intensity": ${stiprumas}, "r": ${spalva.r}, "g": ${spalva.g}, "b": ${spalva.b}}`;
      })
      folder.addBinding(PARAMS, 'Spalva', {
        color: {
          type: 'float'
        },
      }).on('change', (ev) => {
        editor.change_ambient_light_color(ev.value, id);
        spalva = ev.value
        input_element.value = `{"intensity": ${stiprumas}, "r": ${spalva.r}, "g": ${spalva.g}, "b": ${spalva.b}}`;
      })
      const btn = pane.addButton({
        title: 'Ištrinti',
        label: 'Veiksmas',
      }).on('click', () => {
        TWEAKPANE_AMOUNT--;
        removed_ambient.push(temp);
        temp = null;
        editor.remove_ambient_light(id);
        pane.dispose();
        column.remove();
        masonry.remove(column);
        masonry.layout();
        input_element.remove();
      })
      editor.add_ambient_light("white", 10, id)
      settings.appendChild(column);
      masonry.appended(column);
      masonry.layout();
    }
  })

  //Spotlight functionality
  let spotlight_form = document.getElementById("spotlight_input");
  let spotlight_button = document.getElementById("spotlight");
  let spotlight_count = [];
  let removed_spotlight = [];
  for (let x = 1; x <= MAX_TWEAKPANES; x++) {
    spotlight_count.push(x);
  }
  spotlight_button.addEventListener("click", () => {
    if (TWEAKPANE_AMOUNT < MAX_TWEAKPANES) {
      let temp;
      TWEAKPANE_AMOUNT++;
      if (removed_spotlight.length > 0) {
        temp = Math.min(...removed_spotlight);
        const index = removed_spotlight.findIndex(data => data === temp);
        if (index !== -1) {
          removed_spotlight.splice(index, 1);
        }
      } else {
        temp = spotlight_count[0];
        spotlight_count.shift();
      }

      let id = crypto.randomUUID();
      let settings = document.getElementById("settings_row");
      let column = document.createElement("div");
      column.classList = "col-12 col-lg-4 col-md-6 col-sm-6 mb-3 ";

      const INTENSITY = 1000;
      const DISTANCE = 0;
      const PENUMBRA = 0;
      const ANGLE = 90;

      let spalva;
      let koordinates;
      let stiprumas = INTENSITY;
      let atstumas = DISTANCE;
      let penumbra = PENUMBRA;
      let kampas = ANGLE;

      //create and append a html input element
      let input_element = document.createElement("INPUT");
      input_element.setAttribute("type", "hidden");
      input_element.id = id;
      input_element.name = "spotlight";
      let form = document.getElementById("editor_form");
      form.insertBefore(input_element, form.lastElementChild);

      const pane = new Pane({
        container: column
      })
      const PARAMS = {
        Spalva: {
          r: 1,
          g: 1,
          b: 1
        },
        Koordinatės: {
          x: 0,
          y: 10,
          z: 0
        },
      };
      koordinates = PARAMS["Koordinatės"];
      spalva = PARAMS["Spalva"];
      input_element.value = `{"intensity": ${stiprumas}, "distance": ${atstumas}, 
      "penumbra": ${penumbra}, "angle": ${kampas}, "r": ${spalva.r}, "g": ${spalva.g}, "b": ${spalva.b}, "x":${koordinates.x}, "y":${koordinates.y}, "z":${koordinates.z}}`;
      const folder = pane.addFolder({
        title: `Prožektorius_${temp}`,
        expanded: true,
      });
      folder.on('fold', () => {
        setTimeout(() => {
          masonry.layout();
        }, 200);
      });
      folder.addBlade({
        view: 'slider',
        label: 'Stiprumas',
        min: 0,
        max: 3000,
        value: INTENSITY,
      }).on('change', (ev) => {
        editor.change_spotlight_intensity(ev.value, id);
        stiprumas = ev.value;
        input_element.value = `{"intensity": ${stiprumas}, "distance": ${atstumas}, 
      "penumbra": ${penumbra}, "angle": ${kampas}, "r": ${spalva.r}, "g": ${spalva.g}, "b": ${spalva.b}, "x":${koordinates.x}, "y":${koordinates.y}, "z":${koordinates.z}}`;
      });
      folder.addBinding(PARAMS, 'Spalva', {
        color: {
          type: 'float'
        },
      }).on('change', (ev) => {
        editor.change_spotlight_color(ev.value, id);
        spalva = ev.value;
        input_element.value = `{"intensity": ${stiprumas}, "distance": ${atstumas}, 
      "penumbra": ${penumbra}, "angle": ${kampas}, "r": ${spalva.r}, "g": ${spalva.g}, "b": ${spalva.b}, "x":${koordinates.x}, "y":${koordinates.y}, "z":${koordinates.z}}`;
      });
      folder.addBinding(PARAMS, 'Koordinatės').on('change', (ev) => {
        editor.change_spotlight_coordinates(ev.value, id);
      });
      folder.addBlade({
        view: 'slider',
        label: 'Atstumas',
        min: 0,
        max: 100,
        value: DISTANCE,
      }).on('change', (ev) => {
        editor.change_spotlight_distance(ev.value, id);
        atstumas = ev.value;
        input_element.value = `{"intensity": ${stiprumas}, "distance": ${atstumas}, 
      "penumbra": ${penumbra}, "angle": ${kampas}, "r": ${spalva.r}, "g": ${spalva.g}, "b": ${spalva.b}, "x":${koordinates.x}, "y":${koordinates.y}, "z":${koordinates.z}}`;
      });
      folder.addBlade({
        view: 'slider',
        label: 'Penumbra',
        min: 0,
        max: 1,
        value: PENUMBRA,
      }).on('change', (ev) => {
        editor.change_spotlight_penumbra(ev.value, id);
        penumbra = ev.value;
        input_element.value = `{"intensity": ${stiprumas}, "distance": ${atstumas}, 
      "penumbra": ${penumbra}, "angle": ${kampas}, "r": ${spalva.r}, "g": ${spalva.g}, "b": ${spalva.b}, "x":${koordinates.x}, "y":${koordinates.y}, "z":${koordinates.z}}`;
      });
      folder.addBlade({
        view: 'slider',
        label: 'Kampas',
        min: 0,
        max: 90,
        value: ANGLE,
      }).on('change', (ev) => {
        editor.change_spotlight_angle(ev.value, id);
        kampas = ev.value;
        input_element.value = `{"intensity": ${stiprumas}, "distance": ${atstumas}, 
      "penumbra": ${penumbra}, "angle": ${kampas}, "r": ${spalva.r}, "g": ${spalva.g}, "b": ${spalva.b}, "x":${koordinates.x}, "y":${koordinates.y}, "z":${koordinates.z}}`;
      });
      const btn = pane.addButton({
        title: 'Ištrinti',
        label: 'Veiksmas',
      }).on('click', () => {
        TWEAKPANE_AMOUNT--;
        removed_spotlight.push(temp);
        temp = null;
        editor.remove_spotlight(id);
        pane.dispose();
        column.remove();
        masonry.remove(column);
        masonry.layout();
        input_element.remove();
      })
      editor.add_spotlight("white", 1000, 0, Math.PI / 2, 0, {
        x: 0,
        y: 10,
        z: 0
      }, id);
      settings.appendChild(column);
      masonry.appended(column);
      masonry.layout();
    }
  })
  //Interest point functionality
  let interest_count = [];
  let removed_interest = [];
  for (let x = 1; x <= MAX_TWEAKPANES; x++) {
    interest_count.push(x);
  }
  let Interest_button = document.getElementById("interest_point");
  Interest_button.addEventListener("click", () => {
    if (TWEAKPANE_AMOUNT < MAX_TWEAKPANES) {
      let temp;
      TWEAKPANE_AMOUNT++;
      if (removed_interest.length > 0) {
        temp = Math.min(...removed_interest);
        const index = removed_interest.findIndex(data => data === temp);
        if (index !== -1) {
          removed_interest.splice(index, 1);
        }
      } else {
        temp = interest_count[0];
        interest_count.shift();
      }

      let id = crypto.randomUUID();
      let settings = document.getElementById("settings_row");
      let column = document.createElement("div");
      column.classList = "col-12 col-lg-4 col-md-6 col-sm-6 mb-3 ";

      const TEKSTAS = "Įveskite tekstą";

      let koordinates;
      let tekstas = TEKSTAS;

      //create and append a html input element
      let input_element = document.createElement("INPUT");
      input_element.setAttribute("type", "hidden");
      input_element.id = id;
      input_element.name = "interest_point";
      let form = document.getElementById("editor_form");
      form.insertBefore(input_element, form.lastElementChild);

      const pane = new Pane({
        container: column
      });
      const PARAMS = {
        Koordinatės: {
          x: 0,
          y: 0,
          z: 0
        }
      };
      koordinates = PARAMS["Koordinatės"];
      input_element.value = `{"x": ${koordinates.x}, "y": ${koordinates.y}, "z": ${koordinates.z}, "text": "${tekstas}"}`;
      let get_coords = function() {
        let new_cords = editor.get_InterestPoint(id);
        if (new_cords) {
          PARAMS["Koordinatės"].x = new_cords.position.x;
          PARAMS["Koordinatės"].y = new_cords.position.y;
          PARAMS["Koordinatės"].z = new_cords.position.z;
          pane.refresh();
        }
      }
      size_pane.element.addEventListener("click", get_coords);
      const folder = pane.addFolder({
        title: `Dėmesio_taškas_${temp}`,
        expanded: true,
      });
      folder.on('fold', () => {
        setTimeout(() => {
          masonry.layout();
        }, 200);
      });
      folder.addBinding(PARAMS, 'Koordinatės', {
        disabled: true
      });
      folder.addBlade({
        view: 'text',
        label: 'Tekstas',
        parse: (v) => String(v),
        value: 'Įveskite tekstą',
      }).on("change", (ev) => {
        tekstas = ev.value
        input_element.value = `{"x": ${koordinates.x}, "y": ${koordinates.y}, "z": ${koordinates.z}, "text": "${tekstas}"}`;
      });
      const cast_ray = folder.addButton({
        title: 'Nustatyti',
        label: 'Pozicija',
      }).on('click', () => {
        editor.Create_interestPoint(id, (coords) => {
          PARAMS["Koordinatės"].x = coords.x;
          PARAMS["Koordinatės"].y = coords.y;
          PARAMS["Koordinatės"].z = coords.z;
          koordinates = PARAMS["Koordinatės"];
          input_element.value = `{"x": ${koordinates.x}, "y": ${koordinates.y}, "z": ${koordinates.z}, "text": "${tekstas}"}`;
          pane.refresh();
        }, ip_color_state);
      });
      const btn = pane.addButton({
        title: 'Ištrinti',
        label: 'Veiksmas',
      }).on('click', () => {
        TWEAKPANE_AMOUNT--;
        removed_interest.push(temp);
        temp = null;
        editor.Delete_InterestPoint(id);
        pane.dispose();
        column.remove();
        masonry.remove(column);
        masonry.layout();
        input_element.remove();
      });
      settings.appendChild(column);
      masonry.appended(column);
      masonry.layout();
    }
  });
</script>
<%- include('../partials/footer.ejs') %>