<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>
<section id="main_section" class="container padding-container">
  <div id="canvas_container">
    <i class="fa-solid fa-chevron-up fa-2xl" id="open_icon" style="color: #ffffff;"></i>
  </div>
  <div id="settings" class="mb-3">
    <h2>Nustatymai:</h2>
    <input type="checkbox" id="arrow_color" name="arrow_color" form="editor_form" style="display: inline-block;" <%=product["arrows"] == "black" ? "checked" : "" %>>
    <label for="arrow_color">Tamsios rodyklės</label><br>
    <input type="checkbox" id="ip_color" name="ip_color" form="editor_form" style="display: inline-block;" <%=product["ip_color"] == "black" ? "checked" : "" %>>
    <label for="ip_color">Tamsūs dėmesio taškai</label><br>
    <input type="checkbox" onclick="change_icon_color()" id="menu_color" name="menu_color" form="editor_form" style="display: inline-block;" <%=product["menu"] == "black" ? "checked" : "" %>>
    <label for="menu_color">Tamsi meniu ikona</label><br>
    <input type="checkbox" id="title_color" name="title_color" form="editor_form" style="display: inline-block;" <%=product["title_color"] == "black" ? "checked" : "" %>>
    <label for="ip_color">Tamsus pavadinimas</label><br>
    <%if (errors && errors.includes("scale")) { %>
    <span style="color:red">*Netinkamas dydis</span>
    <% } %>
    <%if (errors && errors.includes("tweakpanes")) { %>
    <span style="color:red">*Per daug modulių</span>
    <% } %>
  </div>
  <div id="editor_window" class="mb-3">
    <div id="settings_row" class="row" data-masonry='{"percentPosition": true }'></div>
  </div>
  </div>
  <form id="editor_form" method="POST">
    <div class="dropdown mb-3">
      <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
        Pridėti elementą
      </button>
      <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
        <li id="spotlight"><a class="dropdown-item">Prožektorius</a></li>
        <li id="ambient"><a class="dropdown-item">Supanti šviesa</a></li>
        <li id="interest_point"><a class="dropdown-item">Dėmesio taškas</a></li>
      </ul>
    </div>

    <div class="mb-3">
      <label for="models">Pasirinkite modelį:</label>
      <select name="models" class="form-control" id="models">
        <option value="" selected disabled hidden>Pasirinkite modelį</option>
        <% for(let model of models) { %>
        <option value="<%= model["GLB_ID"]%>" <%- product["model_id"] == model["ID"] ? "selected" : "" %>> <%=model["NAME"]%></option>
        <% } %>
      </select>
      <%if (errors && errors.includes("model")) { %>
      <span style="color:red">Nepasirinktas modelis</span>
      <% } %>
    </div>

    <div class="mb-3">
      <label for="background">Pasirinkite foną:</label>
      <select name="background" class="form-control" id="background">
        <option value="" selected disabled hidden>Pasirinkite foną</option>
        <% for(let cubemap of cubemaps) { %>
        <option value="<%=cubemap["id"]%>" <%- product["cubemap_id"] == cubemap["id"] ? "selected" : "" %>> <%=cubemap["cubemap_folder"]%> </option>
        <% } %>
      </select>
      <%if (errors && errors.includes("background")) { %>
      <span style="color:red">Fonas yra netinkamas</span>
      <% } %>
    </div>

    <div class="mb-3">
      <label for="name">Produkto pavadinimas:</label>
      <input type="text" class="form-control" id="name" name="name" value="<%=product["name"]%>">
      <%if (errors && errors.includes("name")) { %>
      <span style="color:red">Pavadinimo laukelis yra netinkamas</span>
      <% } %>
    </div>

    <div class="mb-3">
      <label for="description">Aprašymas:</label>
      <textarea id="description" class="form-control" name="description" style="resize: none;"><%=product["description"]%></textarea>
      <%if (errors && errors.includes("description")) { %>
      <span style="color:red">Aprašymo laukelis yra netinkamas</span>
      <% } %>
    </div>

    <div class="mb-3">
      <label for="price">Produkto Kaina:</label>
      <div class="input-group mb-3">
        <button type="button" id="price_button" class="btn btn-dark">Redaguoti</button>
        <input type="number" class="form-control" id="price" name="price" value="<%=product["price"]%>">
      </div>
      <%if (errors && errors.includes("price")) { %>
      <span style="color:red">Kaina yra netinkama</span>
      <% } %>

    </div>
    <input type="hidden" id="scale_form" name="scale_form">
    <input type="hidden" id="original_scale" name="original_scale">
    <div>
      <input type="submit" value="Atnaujinti" class="form-control btn btn-dark">
    </div>
  </form>
</section>
<script type="module" src="/3D_scripts/Editor.js"></script>
<script src="/masonry/masonry.pkgd.min.js"></script>
<script>
  window.products = JSON.parse(`<%-JSON.stringify(product)%>`);
  window.spotlights = JSON.parse(`<%-JSON.stringify(spotlights)%>`);
  window.ambient_lights = JSON.parse(`<%-JSON.stringify(ambient_lights)%>`);
  window.interest_points = JSON.parse(`<%-JSON.stringify(interest_points)%>`);
  //change the color of the menu icon
  function change_icon_color() {
    let menu_color = document.getElementById("menu_color");
    if (menu_color.checked) {
      document.getElementById("open_icon").style.color = "black";
    } else {
      document.getElementById("open_icon").style.color = "white";
    }
  }
</script>
<script type="module" src="/scripts/create_product.js"></script>
<%- include('../partials/footer.ejs') %>