<html lang="en">
<%- include('../partials/head.ejs') %>

<body class="d-flex flex-column h-100">
  <%- include('../partials/nav.ejs') %>
    <section class="container my-5">
    <div class="p-5 text-center bg-body-tertiary rounded-3">
      <h1 class="text-body-emphasis">Pakeisti paskyros slaptažodį</h1>
      <p class="lead my-5">
        Norėdami pakeisti slaptažodį, įveskite dabartinį ir naują slaptažodį.
      </p>
    </div>
  </section>

  <section class="container my-5">
    <form method="POST">
      <%if (errors && errors.includes("no_match")) { %>
      <span style="color:red">Slaptažodžio pakeitimas nesėkmingas</span>
      <% } %>
      <div class="mb-3">
        <label for="password">Įveskite dabartinį slaptažodį:</label>
        <input type="password" name="password" id="password" class="form-control" value="" tabindex="1">
        <%if (errors && errors.includes("password_1_inv")) { %>
        <span style="color:red">Dabartinio slaptažodžio laukelis yra netinkamas</span>
        <% } %>
      </div>

      <div class="mb-3">
        <label for="password2">Įveskite naują slaptažodį:</label>
        <input type="password" name="password2" id="password2" class="form-control" value="" tabindex="=2">
        <%if (errors && errors.includes("password_2_inv")) { %>
        <span style="color:red">Naujo slaptažodžio laukelis yra netinkamas</span>
        <% } %>
      </div>

      <div class="mb-3">
        <input type="submit" class="form-control btn btn-dark" value="Pateikti" tabindex="=3">
      </div>
    </form>
  </section>
<%- include('../partials/footer.ejs') %>
</body>
