<html lang="en">
<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>
<section class="container padding-container">
  <form method="POST" enctype='multipart/form-data' action="/upload_profile">
    <div>
      <label for="image">Profilio nuotrauka:</label>
      <img id="image" width="200px" height="200px" class="img-thumbnail" src="<%= (user_data["IMAGE"])%>" alt="image" tabindex="1">
    </div>
    <div>
      <label for="file">Įkelkite nuotrauką: </label>
      <input type="file" id="file" name="file">
      <%if (errors && errors.includes("file_type")) { %>
      <div style="color:red">Tinka tik png, jpg ir jpeg formatai</div>
      <% } %>
      <%if (errors && errors.includes("INV_IMG")) { %>
      <div style="color:red">Netinkama nuotraukos įkeltis</div>
      <% } %>
      <%if (errors && errors.includes("large")) { %>
      <div style="color:red">Nuotrauka per didelė</div>
      <% } %>
    </div>
    <input type="submit" class="btn btn-dark" value="Atnaujinti nuotrauką" tabindex="2">
  </form>
</section>

<section class="container padding-container">
  <form method="POST">
    <div class="mb-3">
      <label for="name">Įveskite savo vardą:</label>
      <div class="input-group mb-3">
        <button type="button" class="edit_button btn btn-dark">Redaguoti</button>
        <input type="text" name="name" class="form-control" id="name" value="<%= (user_data["NAME"])%>" tabindex="3">
      </div>

      <%if (errors && errors.includes("name")) { %>
      <span style="color:red">Vardo laukelis yra netinkamas</span>
      <% } %>
    </div>

    <div class="mb-3">
      <label for="surname">Įveskite savo pavardę:</label>
      <div class="input-group mb-3">
        <button type="button" class="edit_button btn btn-dark">Redaguoti</button>
        <input type="text" name="surname" class="form-control" id="surname" value="<%= (user_data["SURNAME"])%>" tabindex="4">
      </div>
      <%if (errors && errors.includes("surname")) { %>
      <span style="color:red">Pavardės laukelis yra netinkamas</span>
      <% } %>
    </div>

    <div class="mb-3">
      <label for="email">Įveskite savo elektroninį paštą:</label>
      <div class="input-group mb-3">
        <button type="button" class="edit_button btn btn-dark">Redaguoti</button>
        <input type="email" name="email" class="form-control" id="email" value="<%= (user_data["EMAIL"])%>" tabindex="5">
      </div>
      <%if (errors && errors.includes("email_inv")) { %>
      <span style="color:red">Elektroninio pašto laukelis yra netinkamas </span>
      <% } %>
      <%if (errors && errors.includes("email_ex")) { %>
      <span style="color:red">Šis elektroninis paštas jau egzistuoja </span>
      <% } %>
    </div>

    <div class="mb-3">
      <label for="bday">Įveskite savo gimtadienį</label>
      <div class="input-group mb-3">
        <button type="button" class="edit_button btn btn-dark">Redaguoti</button>
        <input type="date" name="bday" class="form-control" id="bday" value="<%= (user_data["BIRTHDAY"]) %>" tabindex="5">
      </div>
      <%if (errors && errors.includes("birthday")) { %>
      <span style="color:red">Gimtadienio laukelis yra netinkamas </span>
      <% } %>
    </div>

    <div class="mb-3">
      <label for="countries">Pasirinkite šalį:</label>
      <select name="countries" class="form-control" id="countries">
        <% for(let country of countries) { %>
        <option value="<%= country["COUNTRY_ID"]%>" <%= country["COUNTRY_ID"] === user_data["COUNTRY_ID"] ? 'selected' : '' %>> <%=country["COUNTRY"]%></option>
        <% } %>
      </select>
    </div>

    <div>
      <input type="submit" value="Pateikti" class="form-control btn btn-dark" tabindex="6">
    </div>
  </form>

  <div>
    <a href="/edit_password">Pakeisti slaptažodį</a>
  </div>

  <div>
    <a href="/delete">Naikinti paskyrą</a>
  </div>
</section>

<%- include('../partials/footer.ejs') %>
<script>
  //read each input and set it to readonly
  let inputs = document.getElementsByTagName("input");
  for (let element of inputs) {
    if (element.type !== "submit" && element.type !== "button" && element.type !== "file") {
      element.readOnly = true;
      element.style.backgroundColor = "lightgrey";
    }
  }
  //toggle the readonly property of each input
  let button_array = document.getElementsByClassName("edit_button");
  for (let button of button_array) {
    button.addEventListener("click", function(target) {
      let parent_input = target.srcElement.parentNode.querySelector("input");
      if (parent_input.readOnly) {
        parent_input.readOnly = false;
        parent_input.style.backgroundColor = "";
      } else {
        parent_input.readOnly = true;
        parent_input.style.backgroundColor = "lightgrey";
      }
    });
  }
</script>