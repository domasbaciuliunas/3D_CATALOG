<%- include('../partials/head.ejs') %>

<body class="d-flex flex-column h-100">
  <%- include('../partials/nav.ejs') %>
  <section class="container my-5">
    <div class="p-5 text-center bg-body-tertiary rounded-3">
      <h1 class="text-body-emphasis">Ištrinti Hybrid3D paskyrą</h1>
      <p class="lead my-5">
        Norėdami ištrinti paskyrą, patvirtinkite savo elektronino pašto adresą.
      </p>
    </div>
  </section>

  <div class="container p-5">
    <form method="POST">
      <div class="mb-3">
        <label for="email">Patvirtinkite savo elektronino pašto adresą:</label>
        <input type="email" id="email" name="email" class="form-control" required>
        <%if (errors && errors.includes("email_inv")) { %>
        <span style="color:red">*Elektroninio pašto adresai nesutampa</span>
        <% } %>
      </div>
      <div class="mb-3">
        <button type="submit" class="form-control">Ištrinti</button>
      </div>
    </form>
  </div>
  <%- include('../partials/footer.ejs') %>
</body>