<%- include('../partials/head.ejs') %>
<body>
    <%- include('../partials/nav.ejs') %>
    <div class="container padding-container">
        <h1>Ištrinti paskyrą</h1>
        <br>
        <form method="POST">
            <div class="mb-3">
            <label for="email">Norėdami ištrinti paskyrą, patvirtinkite savo elektroninį paštą:</label>
            <input type="email" id="email" name="email" class="form-control" required>
            <%if (errors && errors.includes("email_inv")) { %>
                <span style="color:red">Elektroninio pašto adresai nesutampa</span>
                <% } %>
            </div>  
            <div class="mb-3">  
            <button type="submit" class="form-control">Ištrinti</button>
            </div>
        </form>
    </div>
</body>
<%- include('../partials/footer.ejs') %>