<!DOCTYPE html>
<html lang="en" class="h-100">
<%- include('../partials/head.ejs') %>

<body class="d-flex flex-column h-100">
  <section class="container my-5">
    <div class="p-5 text-center bg-body-tertiary rounded-3">
      <h1 class="text-body-emphasis">Hybrid3D cataloging system</h1>
      <p class="lead my-5">
        Inovatyvi Three.js <code>3D elementų</code> katalogavimo sistema.
      </p>
      <img src="/images/icon.png" width="150px" height="150px">
    </div>
  </section>

  <section class="container">
    <div class="p-5 text-center bg-body-tertiary rounded-3">

    </div>
  </section>

  <section class="container p-5">
    <h5>Prisijungimas</h5>
    <form method="POST">
      <div class="mb-3">
        <%if (errors && errors.includes("bad_login")) { %>
        <div style="color:red">Netinkamas Elektroninis paštas arba slaptažodis</div>
        <% } %>
        <label for="email">Elektroninis paštas:</label>
        <input type="email" class="form-control" name="email" id="email" value="" tabindex="1">
        <%if (errors && errors.includes("email_inv")) { %>
        <span style="color:red">Elektroninio pašto laukelis yra tuščias</span>
        <% } %>
      </div>

      <div class="mb-3">
        <label for="password">Slaptažodis:</label>
        <input type="password" class="form-control" name="password" id="password" value="" tabindex="2">
        <%if (errors && errors.includes("password")) { %>
        <span style="color:red">Slaptažodžio laukelis yra tuščiaus</span>
        <% } %>
      </div>

      <div class="mb-3">
        <input type="submit" value="Prisijungti" class="form-control btn btn-dark" tabindex="3">
      </div>
    </form>

    <blockquote cite="/register">
      <p>Neturi paskyros? <a href="/register">Registruokis</a></p>
    </blockquote>
  </section>
  <%- include('../partials/footer.ejs') %>
</body>